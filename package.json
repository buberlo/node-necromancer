{
  "name": "ghost-deps",
  "version": "1.0.0",
  "description": "CLI that scans a project for unused, outdated, or risky dependencies, assigns ghost states, and generates warnings and banish plans.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "ghost": "./bin/ghost.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/ghost.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "dependencies",
    "unused",
    "outdated",
    "risky",
    "ghost",
    "npm"
  ],
  "license": "MIT",
  "dependencies": {}
}